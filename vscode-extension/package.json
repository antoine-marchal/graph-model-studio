{
  "name": "graph-model-studio",
  "displayName": "Graph Model Studio",
  "description": "%s001.gmc.graph.modeling.with.live%",
  "version": "4.1.0",
  "publisher": "graph-model-studio",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "gmc",
    "graph",
    "diagram",
    "architecture",
    "markdown",
    "wysiwyg",
    "editor",
    "notion",
    "rich text",
    "rich diff",
    "diff",
    "md",
    "rich editor",
    "table",
    "math",
    "latex",
    "katex",
    "preview",
    "documentation",
    "notes",
    "note-taking",
    "gfm",
    "writing",
    "wiki",
    "notion-like",
    "rich text editor",
    "live preview",
    "knowledge base",
    "readme",
    "wysiwyg editor",
    "powerpoint",
    "pptx",
    "slides",
    "presentation",
    "deck"
  ],
  "icon": "media/icon.png",
  "main": "./integrations/host.js",
  "activationEvents": [
    "onLanguage:gmc",
    "onLanguage:markdown",
    "onCommand:gmc.openPreview",
    "onCommand:gmc.exportPng",
    "onCommand:gmc.exportMarkdownDiagram",
    "onCommand:gmc.exportAllMarkdownDiagrams",
    "onCommand:markdown-embed.update",
    "onCommand:markdown-embed.updateWorkspace",
    "onCommand:markdown-embed.insertEmbedTag",
    "onCommand:pasteAsMarkdown.copyAsHtml",
    "onCommand:markdownToolkit.formatTable",
    "onCommand:markdownToolkit.exportHtml",
    "onCommand:markdownToolkit.exportPdf",
    "onCommand:markdownToolkit.exportPng",
    "onCommand:markdownToolkit.exportDocx",
    "onCommand:markdownToolkit.export",
    "onCustomEditor:betterMarkdown.editor",
    "onCommand:betterMarkdown.openDiff",
    "workspaceContains:**/*.{deck,slides.md,slides.yaml,slides.yml,slides.json}",
    "workspaceContains:.corporate-slides/master/corporate-master.json",
    "onCustomEditor:corporateSlides.deck",
    "onCustomEditor:corporateSlides.editor",
    "onLanguage:deck"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "betterMarkdown.editor",
        "displayName": "Markdown Studio",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "corporateSlides.deck",
        "displayName": "%s003.deck.visual.editor%",
        "selector": [
          {
            "filenamePattern": "*.deck"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "corporateSlides.editor",
        "displayName": "%s004.corporate.slides.visual.editor%",
        "selector": [
          {
            "filenamePattern": "*.slides.md"
          },
          {
            "filenamePattern": "*.slides.yaml"
          },
          {
            "filenamePattern": "*.slides.yml"
          },
          {
            "filenamePattern": "*.slides.json"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "betterMarkdown.toggleEditor",
        "title": "%s005.toggle.rich.source.editor%",
        "category": "Markdown Studio",
        "icon": "$(notebook-render-output)"
      },
      {
        "command": "betterMarkdown.find",
        "title": "%s006.find.in.document%",
        "category": "Markdown Studio"
      },
      {
        "command": "betterMarkdown.openDiff",
        "title": "%s007.open.rich.diff%",
        "category": "Markdown Studio",
        "icon": "$(diff)"
      },
      {
        "command": "betterMarkdown.factoryReset",
        "title": "%s008.factory.reset.settings%",
        "category": "Markdown Studio"
      },
      {
        "command": "gmc.openPreview",
        "title": "%s009.gmc.open.graph.preview.to%",
        "icon": {
          "light": "./media/preview-graph-light.svg",
          "dark": "./media/preview-graph-dark.svg"
        }
      },
      {
        "command": "gmc.exportPng",
        "title": "%s010.gmc.export.diagram.as.png%",
        "icon": "$(export)"
      },
      {
        "command": "gmc.exportMarkdownDiagram",
        "title": "%s011.gmc.export.markdown.diagram.as%"
      },
      {
        "command": "gmc.exportAllMarkdownDiagrams",
        "title": "%s012.gmc.export.all.markdown.diagrams%"
      },
      {
        "command": "markdown-embed.update",
        "title": "%s013.update.code.embeds%"
      },
      {
        "command": "markdown-embed.updateSingle",
        "title": "%s014.update.single.code.embed%"
      },
      {
        "command": "markdown-embed.goToSource",
        "title": "%s015.go.to.embed.source.file%"
      },
      {
        "command": "markdown-embed.lock",
        "title": "%s016.lock.code.embed%"
      },
      {
        "command": "markdown-embed.unlock",
        "title": "%s017.unlock.code.embed%"
      },
      {
        "command": "markdown-embed.updateWorkspace",
        "title": "%s018.update.all.embeds.in.workspace%"
      },
      {
        "command": "markdown-embed.insertEmbedTag",
        "title": "%s019.copy.embed.tag%"
      },
      {
        "command": "pasteAsMarkdown.copyAsHtml",
        "title": "%s020.copy.as.html%",
        "category": "%s021.paste.as.markdown%",
        "icon": "$(clippy)"
      },
      {
        "command": "markdownToolkit.formatTable",
        "title": "%s022.format.markdown.table%",
        "category": "Markdown Toolkit"
      },
      {
        "command": "markdownToolkit.export",
        "title": "%s024.export.preview%",
        "category": "Markdown Toolkit",
        "icon": "$(export)"
      },
      {
        "command": "markdownToolkit.exportHtml",
        "title": "%s025.export.preview.as.html%",
        "category": "Markdown Toolkit"
      },
      {
        "command": "markdownToolkit.exportPdf",
        "title": "%s026.export.preview.as.pdf%",
        "category": "Markdown Toolkit"
      },
      {
        "command": "markdownToolkit.exportPng",
        "title": "%s027.export.preview.as.png%",
        "category": "Markdown Toolkit"
      },
      {
        "command": "markdownToolkit.exportDocx",
        "title": "%s028.export.as.docx.with.pandoc%",
        "category": "Markdown Toolkit"
      },
      {
        "command": "betterMarkdown.toggleZen",
        "title": "%s029.toggle.zen.mode%",
        "category": "Markdown Studio",
        "icon": "$(screen-full)"
      },
      {
        "command": "betterMarkdown.insertEmbed",
        "title": "%s030.insert.file.embed%",
        "category": "Markdown Studio"
      },
      {
        "command": "betterMarkdown.insertLink",
        "title": "%s031.insert.file.link%",
        "category": "Markdown Studio"
      },
      {
        "command": "betterMarkdown.insertToc",
        "title": "%s032.insert.table.of.contents%",
        "category": "Markdown Studio"
      },
      {
        "command": "betterMarkdown.updateEmbeds",
        "title": "%s033.update.embeds.toc%",
        "category": "Markdown Studio"
      },
      {
        "command": "corporateSlides.importTemplate",
        "title": "%s034.import.a.powerpoint.template%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.importPresentation",
        "title": "%s036.import.a.powerpoint.presentation.pptx%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.showMasters",
        "title": "%s037.show.corporate.masters%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.newPresentation",
        "title": "%s038.new.presentation%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.openVisualEditor",
        "title": "%s039.open.visual.editor%",
        "category": "Corporate Slides",
        "icon": {
          "light": "./media/preview-slides-light.svg",
          "dark": "./media/preview-slides-dark.svg"
        }
      },
      {
        "command": "corporateSlides.exportPptx",
        "title": "%s040.export.to.powerpoint.pptx%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.validate",
        "title": "%s041.validate.presentation%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.renderReference",
        "title": "%s042.reference.rendering.powerpoint.libreoffice%",
        "category": "Corporate Slides"
      },
      {
        "command": "corporateSlides.toggleEditor",
        "title": "%s043.toggle.visual.source.editor%",
        "category": "Corporate Slides",
        "icon": {
          "light": "./media/preview-slides-light.svg",
          "dark": "./media/preview-slides-dark.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "betterMarkdown.toggleEditor",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "resourceExtname == .md"
      },
      {
        "command": "betterMarkdown.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == betterMarkdown.editor"
      },
      {
        "command": "pasteAsMarkdown.copyAsHtml",
        "key": "ctrl+c",
        "mac": "cmd+c",
        "when": "editorLangId == markdown && config.pasteAsMarkdown.copyAsHtmlOnCopy"
      },
      {
        "command": "markdownToolkit.formatTable",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus && editorLangId == markdown"
      },
      {
        "command": "betterMarkdown.toggleZen",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "activeCustomEditorId == betterMarkdown.editor"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "betterMarkdown.openDiff",
          "when": "resourceExtname == .md || isInDiffEditor"
        }
      ],
      "editor/title": [
        {
          "command": "betterMarkdown.toggleEditor",
          "group": "navigation",
          "when": "resourceExtname == .md"
        },
        {
          "command": "betterMarkdown.openDiff",
          "group": "navigation",
          "when": "isInDiffEditor && resourceExtname == .md"
        },
        {
          "command": "gmc.openPreview",
          "when": "resourceLangId == gmc || resourceLangId == markdown",
          "group": "navigation@10"
        },
        {
          "command": "gmc.exportPng",
          "when": "resourceLangId == gmc",
          "group": "navigation@11"
        },
        {
          "command": "markdownToolkit.export",
          "when": "activeWebviewPanelId == 'markdown.preview' || activeCustomEditorId == 'vscode.markdown.preview.editor'",
          "group": "navigation@20"
        },
        {
          "command": "corporateSlides.toggleEditor",
          "when": "resourceExtname == .deck",
          "group": "navigation"
        },
        {
          "command": "corporateSlides.openVisualEditor",
          "when": "resourceFilename =~ /[.]slides[.](md|ya?ml|json)$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "betterMarkdown.openDiff",
          "group": "1_modification",
          "when": "scmProvider == git && resourceExtname == .md"
        }
      ],
      "editor/context": [
        {
          "command": "markdown-embed.insertEmbedTag",
          "when": "editorTextFocus && resourceLangId != markdown",
          "group": "navigation"
        },
        {
          "command": "pasteAsMarkdown.copyAsHtml",
          "when": "editorLangId == markdown",
          "group": "9_cutcopypaste"
        },
        {
          "command": "markdownToolkit.formatTable",
          "when": "editorLangId == markdown",
          "group": "1_modification"
        },
        {
          "command": "betterMarkdown.insertEmbed",
          "when": "editorLangId == markdown",
          "group": "1_modification@10"
        },
        {
          "command": "betterMarkdown.insertLink",
          "when": "editorLangId == markdown",
          "group": "1_modification@11"
        },
        {
          "command": "betterMarkdown.insertToc",
          "when": "editorLangId == markdown",
          "group": "1_modification@12"
        }
      ],
      "explorer/context": [
        {
          "command": "pasteAsMarkdown.copyAsHtml",
          "when": "resourceLangId == markdown",
          "group": "9_cutcopypaste"
        },
        {
          "command": "corporateSlides.importTemplate",
          "when": "resourceExtname == .pptx || resourceExtname == .potx",
          "group": "navigation"
        },
        {
          "command": "corporateSlides.exportPptx",
          "when": "resourceFilename =~ /([.]slides[.](md|ya?ml|json)|[.]deck)$/",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "betterMarkdown.insertEmbed",
          "when": "webviewId == 'betterMarkdown.editor'",
          "group": "1_insert@1"
        },
        {
          "command": "betterMarkdown.insertLink",
          "when": "webviewId == 'betterMarkdown.editor'",
          "group": "1_insert@2"
        },
        {
          "command": "betterMarkdown.insertToc",
          "when": "webviewId == 'betterMarkdown.editor'",
          "group": "1_insert@3"
        },
        {
          "command": "betterMarkdown.updateEmbeds",
          "when": "webviewId == 'betterMarkdown.editor'",
          "group": "2_embeds@1"
        },
        {
          "command": "betterMarkdown.toggleZen",
          "when": "webviewId == 'betterMarkdown.editor'",
          "group": "3_view@1"
        }
      ]
    },
    "configuration": [
      {
        "title": "Markdown Studio",
        "properties": {
          "markdownStudio.saveOnEdit": {
            "type": "boolean",
            "default": false,
            "order": 2,
            "markdownDescription": "%s044.save.the.file.automatically.shortly%"
          },
          "markdownStudio.bullet": {
            "type": "string",
            "enum": [
              "-",
              "*",
              "+"
            ],
            "enumDescriptions": [
              "dash",
              "star",
              "plus"
            ],
            "default": "-",
            "order": 10,
            "markdownDescription": "%s048.bullet.character.for.unordered.lists%"
          },
          "markdownStudio.emphasis": {
            "type": "string",
            "enum": [
              "_",
              "*"
            ],
            "enumDescriptions": [
              "_italic_",
              "*italic*"
            ],
            "default": "_",
            "order": 11,
            "markdownDescription": "%s051.emphasis.italic.marker%"
          },
          "markdownStudio.strong": {
            "type": "string",
            "enum": [
              "**",
              "__"
            ],
            "enumDescriptions": [
              "**bold**",
              "__bold__"
            ],
            "default": "**",
            "order": 12,
            "markdownDescription": "%s054.strong.bold.marker%"
          },
          "markdownStudio.rule": {
            "type": "string",
            "enum": [
              "-",
              "*",
              "_"
            ],
            "enumDescriptions": [
              "---",
              "***",
              "___"
            ],
            "default": "-",
            "order": 13,
            "markdownDescription": "%s058.horizontal.rule.character.rendered.as%"
          },
          "markdownStudio.listItemIndent": {
            "type": "string",
            "enum": [
              "one",
              "tab",
              "mixed"
            ],
            "enumDescriptions": [
              "%s059.1.space%",
              "%s060.tab%",
              "%s061.mixed%"
            ],
            "default": "one",
            "order": 14,
            "markdownDescription": "%s062.continuation.indent.for.list.items%"
          },
          "markdownStudio.bubbleMenuShortcut": {
            "type": "string",
            "default": "Mod+/",
            "order": 20,
            "markdownDescription": "%s063.keybinding.that.opens.the.selection%"
          },
          "markdownStudio.defaultCodeBlockLang": {
            "type": "string",
            "default": "",
            "order": 30,
            "markdownDescription": "%s064.language.label.applied.to.unlabelled%"
          },
          "markdownStudio.diffMode": {
            "type": "string",
            "enum": [
              "source",
              "rendered"
            ],
            "enumDescriptions": [
              "%s065.source.line.diff%",
              "%s066.rendered.html.diff%"
            ],
            "default": "rendered",
            "order": 40,
            "markdownDescription": "%s067.default.view.for.the.rich%"
          },
          "markdownStudio.diffLayout": {
            "type": "string",
            "enum": [
              "unified",
              "side-by-side"
            ],
            "enumDescriptions": [
              "%s068.unified%",
              "%s069.side.by.side%"
            ],
            "default": "side-by-side",
            "order": 41,
            "markdownDescription": "%s070.layout.for.the.source.line%"
          },
          "markdownStudio.compactLists": {
            "type": "boolean",
            "default": true,
            "order": 50,
            "markdownDescription": "%s071.remove.blank.lines.between.consecutive%"
          },
          "markdownStudio.unescapeSpecialChars": {
            "type": "boolean",
            "default": true,
            "order": 51,
            "markdownDescription": "%s072.strip.redundant.escapes.that.remark%"
          },
          "markdownStudio.renumberOrderedLists": {
            "type": "boolean",
            "default": true,
            "order": 52,
            "markdownDescription": "%s073.renumber.ordered.list.items.to%"
          },
          "markdownStudio.shellscriptToBash": {
            "type": "boolean",
            "default": true,
            "order": 53,
            "markdownDescription": "%s074.rewrite.code.fences.labelled.shellscript%"
          },
          "markdownStudio.fixTableHeaders": {
            "type": "boolean",
            "default": true,
            "order": 54,
            "markdownDescription": "%s075.rebuild.table.headers.when.rehype%"
          },
          "markdownStudio.dedupImageAltText": {
            "type": "boolean",
            "default": true,
            "order": 55,
            "markdownDescription": "%s076.collapse.alt.x.nalt.alt%"
          },
          "markdownStudio.theme": {
            "type": "string",
            "enum": [
              "default",
              "github-light",
              "github-light-high-contrast",
              "github-light-colorblind",
              "github-light-tritanopia",
              "github-dark",
              "github-dark-high-contrast",
              "github-dark-colorblind",
              "github-dark-tritanopia",
              "github-dark-dimmed",
              "claude-light",
              "claude-dark"
            ],
            "enumDescriptions": [
              "%s077.default.follow.vs.code%",
              "GitHub Light",
              "GitHub Light High Contrast",
              "GitHub Light Protanopia & Deuteranopia",
              "GitHub Light Tritanopia",
              "GitHub Dark",
              "GitHub Dark High Contrast",
              "GitHub Dark Protanopia & Deuteranopia",
              "GitHub Dark Tritanopia",
              "GitHub Dark Dimmed",
              "Claude Light",
              "Claude Dark"
            ],
            "default": "default",
            "order": 60,
            "markdownDescription": "%s089.color.theme.for.the.rich%"
          },
          "markdownStudio.customCss": {
            "type": "string",
            "default": "",
            "order": 61,
            "markdownDescription": "%s090.path.to.a.css.file%"
          },
          "markdownStudio.contentWidth": {
            "type": "number",
            "default": 760,
            "minimum": 480,
            "maximum": 1600,
            "order": 62,
            "markdownDescription": "%s091.maximum.width.of.the.centered%"
          },
          "markdownStudio.fontSize": {
            "type": "number",
            "default": 15,
            "minimum": 8,
            "maximum": 32,
            "order": 63,
            "markdownDescription": "%s092.body.text.size.in.the%"
          },
          "markdownStudio.lineHeight": {
            "type": "number",
            "default": 1.6,
            "minimum": 1.3,
            "maximum": 2.2,
            "order": 64,
            "markdownDescription": "%s093.space.between.lines.of.text%"
          },
          "markdownStudio.fontFamily": {
            "type": "string",
            "default": "",
            "order": 65,
            "markdownDescription": "%s094.font.family.for.body.text%"
          },
          "markdownStudio.tocHeading": {
            "type": "boolean",
            "default": true,
            "order": 66,
            "markdownDescription": "%s095.add.a.heading.above.generated%"
          },
          "markdownStudio.exportTheme": {
            "type": "string",
            "enum": [
              "light",
              "editor"
            ],
            "enumDescriptions": [
              "%s096.light.theme.on.a.transparent%",
              "%s097.the.rich.editor.s.current%"
            ],
            "default": "light",
            "order": 68,
            "markdownDescription": "%s098.colors.of.html.pdf.png%"
          },
          "markdownStudio.assetsFolder": {
            "type": "string",
            "default": "",
            "order": 69,
            "markdownDescription": "%s099.folder.for.assets.gmc.files%"
          },
          "markdownStudio.tocHeadingText": {
            "type": "string",
            "default": "Table of content",
            "order": 67,
            "markdownDescription": "%s100.text.of.the.heading.added%"
          },
          "markdownStudio.lineNumbers": {
            "type": "boolean",
            "default": false,
            "order": 66,
            "markdownDescription": "%s101.show.the.markdown.source.line%"
          },
          "markdownStudio.indentHeadings": {
            "type": "boolean",
            "default": false,
            "order": 66,
            "markdownDescription": "%s102.indent.each.heading.and.its%"
          },
          "markdownStudio.outlineStyle": {
            "type": "string",
            "enum": [
              "rail",
              "panel",
              "off"
            ],
            "default": "rail",
            "order": 67,
            "enumDescriptions": [
              "%s103.compact.rail.of.heading.marks%",
              "%s104.resizable.contents.sidebar.with.a%",
              "%s105.no.heading.navigator%"
            ],
            "markdownDescription": "%s106.how.the.heading.outline.is%"
          },
          "markdownStudio.tableVerticalAlign": {
            "type": "string",
            "enum": [
              "top",
              "middle",
              "bottom"
            ],
            "default": "top",
            "order": 68,
            "enumDescriptions": [
              "%s107.cell.content.at.the.top%",
              "%s108.cell.content.vertically.centered%",
              "%s109.cell.content.at.the.bottom%"
            ],
            "markdownDescription": "%s110.vertical.alignment.of.table.cell%"
          }
        }
      },
      {
        "title": "%s111.graph.model.studio.gmc.diagrams%",
        "properties": {
          "gmc.preview.autoOpen": {
            "type": "boolean",
            "default": false,
            "description": "%s112.automatically.open.the.graph.preview%"
          },
          "gmc.export.width": {
            "type": "number",
            "default": 1600,
            "minimum": 320,
            "maximum": 8192,
            "description": "%s113.png.export.width.in.pixels%"
          },
          "gmc.export.height": {
            "type": "number",
            "default": 1000,
            "minimum": 240,
            "maximum": 8192,
            "description": "%s114.png.export.height.in.pixels%"
          },
          "gmc.export.theme": {
            "type": "string",
            "enum": [
              "auto",
              "light",
              "dark"
            ],
            "default": "auto",
            "description": "%s115.theme.used.for.png.export%"
          },
          "gmc.export.renderOnSave": {
            "type": "boolean",
            "default": false,
            "markdownDescription": "%s116.re.render.changed.gmc.image%"
          },
          "markdownEmbedder.autoUpdate": {
            "type": "boolean",
            "default": false,
            "description": "%s117.automatically.update.embeds.in.markdown%"
          },
