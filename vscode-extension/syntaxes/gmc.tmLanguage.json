{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Graph Model Code",
  "scopeName": "source.gmc",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#declarations" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.gmc", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.gmc",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.gmc", "match": "\\\\." }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gmc",
          "match": "\\b(model|views|view|include_relations|include|autolayout|of|description|technology|tags|properties|size|at|anchor|directed|undirected|bidirectional|archimate|bpmn|flowchart)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.gmc",
          "match": "\\b(person|softwareSystem|container|component|codeElement|businessActor|businessRole|businessProcess|applicationComponent|applicationService|dataObject|technologyNode|device|systemSoftware|artifact|startEvent|endEvent|task|userTask|serviceTask|gateway|exclusiveGateway|parallelGateway|pool|lane|start|end|process|decision|inputOutput|connector|node|group|external)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.gmc", "match": "(?<![\\w.])-?\\d+(?:\\.\\d+)?" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.gmc", "match": "->" },
        { "name": "keyword.operator.assignment.gmc", "match": "=" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][\\w.]*)\\s*(?==)",
          "captures": {
            "1": { "name": "entity.name.type.gmc" }
          }
        }
      ]
    }
  }
}
