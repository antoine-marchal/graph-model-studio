{
  "scopeName": "markdown.gmc.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "name": "markup.fenced_code.block.markdown",
      "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:gmc|graphmodel)(?:\\s+[^`]*)?$",
      "beginCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "end": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*$",
      "endCaptures": {
        "3": { "name": "punctuation.definition.markdown" }
      },
      "contentName": "meta.embedded.block.gmc",
      "patterns": [
        { "include": "source.gmc" }
      ]
    }
  ]
}
